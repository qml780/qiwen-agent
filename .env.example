# Browser-safe API origin. Never place provider secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend only
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_CODE_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2
# 每百万 token 的人民币估算价；价格变化时只改环境变量，不改业务代码。
DEEPSEEK_FLASH_INPUT_CNY_PER_MILLION=1.01
DEEPSEEK_FLASH_OUTPUT_CNY_PER_MILLION=2.02
DEEPSEEK_PRO_INPUT_CNY_PER_MILLION=3.13
DEEPSEEK_PRO_OUTPUT_CNY_PER_MILLION=6.26
# 米醋聊天/代码（OpenAI Responses 兼容）；使用单独的 Codex/GPT 分组 Key。
MICU_LLM_API_KEY=
MICU_MUSIC_LLM_API_KEY=
MICU_MUSIC_MODEL=gpt-5.6-luna
MICU_BASE_URL=https://www.micuapi.ai/v1
MICU_CHAT_MODEL=gpt-5.6-terra
MICU_CODE_MODEL=gpt-5.6-sol
MICU_TIMEOUT_SECONDS=120
MICU_MAX_RETRIES=2
# 以米醋控制台实时单价填写；0 表示尚未配置成本估算，并不代表免费。
MICU_CHAT_INPUT_CNY_PER_MILLION=0
MICU_CHAT_OUTPUT_CNY_PER_MILLION=0
MICU_CODE_INPUT_CNY_PER_MILLION=0
MICU_CODE_OUTPUT_CNY_PER_MILLION=0
MICU_ESTIMATED_CNY_PER_CALL=0.1
API_MONTHLY_BUDGET_CNY=30
DATABASE_URL=postgresql+psycopg://qiwen:qiwen_local@127.0.0.1:55432/qiwen
# OBJECT_STORAGE_ROOT 可选；未设置时使用项目内 storage\objects（该目录不会提交到 Git）。

# M4 真实资产 Provider；凭据缺失时自动使用同构 Mock。
MICU_IMAGE_API_KEY=
MICU_IMAGE_BASE_URL=https://www.micuapi.ai/v1
MICU_IMAGE_MODEL=gpt-image-2-pro
MICU_IMAGE_SIZE=1024x1024
MICU_IMAGE_TIMEOUT_SECONDS=180
MICU_IMAGE_ESTIMATED_COST_CNY=1
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
JIMENG_REQ_KEY=t2i_v40_jimeng
JIMENG_ESTIMATED_COST_CNY=1
HUNYUAN3D_API_KEY=
HUNYUAN3D_BASE_URL=https://tokenhub.tencentmaas.com/v1/api/3d
HUNYUAN3D_MODEL=hy-3d-3.1
HUNYUAN3D_ESTIMATED_COST_CNY=10
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_MPS_REGION=ap-guangzhou
TENCENT_MPS_MUSIC_MODEL=
TENCENT_MPS_MUSIC_MODEL_VERSION=
TENCENT_MPS_ESTIMATED_COST_CNY=2
